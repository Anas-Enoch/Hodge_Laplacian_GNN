# Git LFS — large scientific artifacts
# Run: git lfs install  (once per machine)
# Then commit this file and the objects will be tracked via LFS.

# AnnData / HDF5 objects
*.h5ad  filter=lfs diff=lfs merge=lfs -text
*.h5    filter=lfs diff=lfs merge=lfs -text
*.hdf5  filter=lfs diff=lfs merge=lfs -text

# Numpy arrays
*.npz   filter=lfs diff=lfs merge=lfs -text
*.npy   filter=lfs diff=lfs merge=lfs -text

# Model weights
*.pt    filter=lfs diff=lfs merge=lfs -text
*.pth   filter=lfs diff=lfs merge=lfs -text

# Large CSV files in intermediate results
results/intermediate/*.csv  filter=lfs diff=lfs merge=lfs -text
archive/generated_outputs/*.csv  filter=lfs diff=lfs merge=lfs -text

# Compressed archives
*.tar.gz  filter=lfs diff=lfs merge=lfs -text
*.zip     filter=lfs diff=lfs merge=lfs -text

# ── Text normalization ────────────────────────────────────────────────────
*         text=auto
*.py      text eol=lf
*.sh      text eol=lf
*.md      text eol=lf
*.tex     text eol=lf
*.bib     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf

# ── Binary (no diff) ─────────────────────────────────────────────────────
*.png     binary
*.pdf     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
