# ── Large scientific data (regenerate from pipeline or download from Zenodo) ──
*.h5ad
*.h5
*.hdf5
*.npz
*.npy

# ── Intermediate per-sample outputs (reproducible, not tracked) ───────────
results/intermediate/
archive/generated_outputs/
stats/CSV_GSM/

# ── Per-GSM step outputs ──────────────────────────────────────────────────
GSM_*_step*.csv
GSM_*_step*.png
GSM_*_step*.pdf

# ── Large temporary figures ───────────────────────────────────────────────
*_debug*.png
*_DEBUG.*
*_tmp.png
scratch_*.png

# ── Model checkpoints ─────────────────────────────────────────────────────
*.pt
*.pth
*.ckpt
*.safetensors
checkpoints/
models/saved/
lightning_logs/

# ── Python cache ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.conda/

# ── Build artifacts ───────────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/

# ── LaTeX build artifacts ─────────────────────────────────────────────────
paper/manuscript/*.aux
paper/manuscript/*.bbl
paper/manuscript/*.blg
paper/manuscript/*.fdb_latexmk
paper/manuscript/*.fls
paper/manuscript/*.log
paper/manuscript/*.out
paper/manuscript/*.synctex.gz
paper/manuscript/*.toc

# ── Local backup folders ──────────────────────────────────────────────────
archive/reorganization_backup/
local_backup/
tmp/
temp/

# ── OS / Editor ───────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
wandb/
